#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
if ! python3 -c 'import yaml' >/dev/null 2>&1; then
  case "${1:-setup}" in
    setup|resume)
      if command -v apt-get >/dev/null 2>&1; then
        if [ "$(id -u)" -eq 0 ]; then
          apt-get update -qq && apt-get install -y -qq python3-yaml
        else
          sudo apt-get update -qq && sudo apt-get install -y -qq python3-yaml
        fi
      else
        echo 'The setup AI needs to install PyYAML for this computer’s Python before continuing.' >&2
        exit 1
      fi ;;
    *) echo 'Setup dependency PyYAML is missing; resume the guided installer.' >&2; exit 1 ;;
  esac
fi
exec python3 -m onboarding "$@"
